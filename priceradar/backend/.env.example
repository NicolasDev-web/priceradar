# Copie para .env e preencha. O .env NUNCA deve ser commitado.

# true = dados fictícios, sem rede. Use para desenvolver o frontend.
MOCK=false

# ── Camada de acesso ─────────────────────────────────────────────────────────
# A coleta escala do mais barato para o mais caro:
#   1. curl-cffi (TLS de Chrome real) — grátis, ~1s, resolve a maioria
#   2. ScraperAPI — 1 crédito por requisição, usada só se o nível 1 falhar
#   3. Playwright — último recurso, a cargo de cada scraper
HABILITAR_FETCH_DIRETO=true
HABILITAR_SCRAPERAPI=true

# Perfil de browser imitado pelo curl-cffi. chrome131 passou em todos os
# portais testados; safari17_0 falha no ImovelWeb.
CURL_IMPERSONATE=chrome131

# Só é usada quando o acesso direto falha. Plano gratuito: 1.000 créditos/mês.
SCRAPERAPI_KEY=

# Timeout por requisição, em segundos.
SCRAPER_TIMEOUT=30

VIVAREAL_BASE_URL=https://www.vivareal.com.br

# ── Fontes ───────────────────────────────────────────────────────────────────
# Ligadas: entregam volume de forma consistente.
HABILITAR_CHAVESNAMAO=true
HABILITAR_IMOVELWEB=true

# Desligadas, com o motivo medido em 29/07/2026. Antes de religar, meça com
# a skill `diagnosticar-scraper` — cada fonte morta custa tempo em toda busca.
#   olx          — acesso destravado, mas o parser está defasado (RSC)
#   mercadolivre — página só renderiza com JS; Playwright devolve 0
#   quintoandar  — listagem 100% client-side, sem dados no HTML inicial
#   netimoveis   — portal concentrado em MG; sem inventário em outras praças
HABILITAR_OLX=false
HABILITAR_MERCADOLIVRE=false
HABILITAR_QUINTOANDAR=false
HABILITAR_NETIMOVEIS=false

# ── Paginação ────────────────────────────────────────────────────────────────
# VivaReal/Zap/ImovelWeb: 2 páginas bastam (a 3ª quase não traz item novo).
VIVAREAL_MAX_PAGINAS=2
ZAP_MAX_PAGINAS=2
IMOVELWEB_MAX_PAGINAS=2
# ChavesNaMão não filtra preço server-side: só ~30% de cada página cai na
# faixa pedida, então compensa varrer mais páginas — são gratuitas.
CHAVESNAMAO_MAX_PAGINAS=12

# ── Refino ───────────────────────────────────────────────────────────────────
HABILITAR_RF_REFINER=true
HABILITAR_DEDUP_CROSS_PORTAL=true

# Banda de preço plausível, relativa à mediana do grupo (cidade + tipologia).
# O corte inferior pega preço de entrada/parcela; o superior pega área
# agregada e erro de parsing.
RF_RATIO_MINIMO_PRECO=0.50
RF_RATIO_MAXIMO_PRECO=1.80
RF_CONTAMINATION=0.05
RF_DESVIO_THRESHOLD=3.5

# Confiança mínima para considerar dois anúncios o mesmo imóvel, e
# similaridade mínima de localização (condição necessária para fundir).
DEDUP_LIMIAR=0.85
DEDUP_LIMIAR_BAIRRO=0.80

# ── Cache ────────────────────────────────────────────────────────────────────
# Validade do cache de buscas, em minutos. Uma busca idêntica feita dentro
# desse tempo reaproveita os resultados do banco em vez de refazer a coleta.
CACHE_MINUTOS=60
