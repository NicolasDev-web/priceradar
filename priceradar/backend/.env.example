MOCK=false
VIVAREAL_BASE_URL=https://www.vivareal.com.br

# Chave da ScraperAPI (obrigatória para o scraping real)
SCRAPERAPI_KEY=

# Validade do cache de buscas, em minutos. Uma busca idêntica feita dentro desse
# tempo reaproveita os resultados do banco em vez de refazer o scraping.
CACHE_MINUTOS=60

# Timeout (segundos) de cada requisição à ScraperAPI. Como usamos render=false,
# as respostas vêm em ~2-5s; 25s cobre folga sem travar em erros transitórios.
SCRAPER_TIMEOUT=25

# Habilita o scraper do OLX (desativado por padrão — bloqueia requisições de servidor).
HABILITAR_OLX=false
