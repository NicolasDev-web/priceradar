# Variáveis do deploy em VM (Trilha A). Copie para `.env` NA RAIZ do repositório
# — é o arquivo que o `docker-compose.yml` lê. Não confundir com
# `priceradar/backend/.env`, que é o do desenvolvimento local.
#
# Nada aqui é commitado: o `.gitignore` já cobre `.env`.

# ── Borda (Caddy) ────────────────────────────────────────────────────────────
# Domínio que aponta para o IP da VM. Sem domínio próprio, um subdomínio
# gratuito (DuckDNS) resolve — o Let's Encrypt emite certificado igual.
DOMINIO=priceradar.exemplo.duckdns.org

# Login único, compartilhado pelas duas pessoas. Gere o hash com:
#   docker run --rm caddy:2-alpine caddy hash-password
USUARIO=comercial
SENHA_HASH=

# ── Aplicação ────────────────────────────────────────────────────────────────
# Os caminhos de estado (DATABASE_URL, BAIRROS_CACHE_PATH, HISTORICO_FONTES_PATH,
# BROWSER_PROFILE_DIR) já vêm definidos no Dockerfile, apontando para o volume
# /data. Só redefina aqui se quiser mudar de lugar.

MOCK=false

# Nível 2 da coleta. Deixe em branco enquanto o nível 1 (curl-cffi) estiver
# respondendo — foi para medir isso que existe `scripts/sonda_acesso.py`. Se a
# sonda mostrar 403 na nuvem, é esta chave que segura a coleta, e aí o plano
# gratuito (1.000 créditos/mês, ~40 buscas) passa a ser o teto real de uso.
SCRAPERAPI_KEY=

CACHE_MINUTOS=60
